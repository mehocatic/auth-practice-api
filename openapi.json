{
	"openapi": "3.0.0",
	"info": {
		"title": "Auth Practice API",
		"version": "1.0.0"
	},
	"components": {
		"securitySchemes": {
			"bearerAuth": {
				"type": "http",
				"scheme": "bearer",
				"bearerFormat": "JWT"
			}
		}
	},
	"paths": {
		"/auth/signup": {
			"post": {
				"summary": "Create a new user account",
				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"type": "object",
								"properties": {
									"email": { "type": "string" },
									"password": { "type": "string" }
								}
							}
						}
					}
				},
				"responses": { "201": { "description": "Created" } }
			}
		},
		"/auth/login": {
			"post": {
				"summary": "Authenticate and return a JWT",
				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"type": "object",
								"properties": {
									"email": { "type": "string" },
									"password": { "type": "string" }
								}
							}
						}
					}
				},
				"responses": { "200": { "description": "OK" } }
			}
		},
		"/auth/logout": {
			"post": {
				"summary": "End the user's session",
				"security": [{ "bearerAuth": [] }],
				"responses": { "204": { "description": "No Content" } }
			}
		},
		"/protected/profile": {
			"get": {
				"summary": "Read private profile data",
				"security": [{ "bearerAuth": [] }],
				"responses": { "200": { "description": "OK" } }
			}
		},
		"/protected/dashboard": {
			"get": {
				"summary": "Read private dashboard data",
				"security": [{ "bearerAuth": [] }],
				"responses": { "200": { "description": "OK" } }
			}
		},
		"/public/info": {
			"get": {
				"summary": "Read public, open data",
				"responses": { "200": { "description": "OK" } }
			}
		}
	}
}
